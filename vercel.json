{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/style.css", "destination": "/style.css" },
    { "source": "/css/(.*)", "destination": "/css/$1" },
    { "source": "/", "destination": "/public/login.html" },
    { "source": "/home", "destination": "/index.html" },
    { "source": "/login", "destination": "/public/login.html" },
    { "source": "/admin", "destination": "/public/admin.html" },
    { "source": "/shop", "destination": "/public/shop.html" },
    { "source": "/about", "destination": "/public/about.html" },
    { "source": "/event", "destination": "/public/event.html" },
    { "source": "/info", "destination": "/public/info.html" },
    { "source": "/music", "destination": "/public/music.html" },
    { "source": "/register", "destination": "/public/register.html" }
  ]
}
